VITE_DATA_PROVIDER=supabase

# Supabase (navegador: front)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cesium ion (navegador: front). Abre la capa "Vista 3D real" del mapa.
# Token de https://ion.cesium.com/tokens, con el asset "Cesium World Terrain"
# habilitado. El modo Cesium inicia con Google Photorealistic 3D y usa este
# token; la capa requiere conexión y puede consumir cuota ion. Sin token el modo
# 3D no se ofrece y el resto del mapa funciona.
# OJO: el plan gratuito de ion Community es de licencia PERSONAL Y NO
# COMERCIAL y su cuota son 1.000 root tiles/mes. Revisar la licencia si el
# mapa publicado se monetiza o si la cuota deja de alcanzar.
VITE_CESIUM_TOKEN=

# ------------------------------------------------------------
# Variables de SERVIDOR (Vercel -> Settings -> Environment Variables).
# Nada de esto se usa en el navegador: son para las funciones de api/.
# ------------------------------------------------------------
# api/hotmart-webhook.ts
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
HOTMART_SECRET=

# api/cron/cuotas-vencimiento.ts (aviso de cuotas vencidas / por vencer)
# Se dispara con el cron de vercel.json todos los dias 8:00 UTC y Vercel
# manda "Authorization: Bearer <CRON_SECRET>" en cada llamada.
CRON_SECRET=
# Base del sitio para el link al portal del cliente (opcional).
APP_URL=https://lotesalmando.com
# Valor de respaldo si una empresa no tiene configuracion de avisos (opcional, 5).
# La anticipacion principal se configura por empresa en Configuracion.
DIAS_AVISO_CUOTA=5

# Correo (SMTP de Gmail con contrasena de aplicacion). Sin EMAIL_USER /
# EMAIL_PASS los envios se omiten y los webhooks y el cron siguen andando.
EMAIL_USER=
EMAIL_PASS=
# Nombre visible opcional: "Lotes al Mando <tu.correo@gmail.com>"
EMAIL_FROM=
# A quien avisar si entra un pago de Hotmart sin cuenta (opcional).
ADMIN_EMAIL=
